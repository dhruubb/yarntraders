# ---- Required ----
# PostgreSQL connection string.
#   Local:   postgres://yarn:yarn@localhost:5432/yarncrm
#   Render:  paste the "External Database URL" from the Render dashboard
DATABASE_URL=postgres://yarn:yarn@localhost:5432/yarncrm

# Long random string protecting the scheduled-job URLs. Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# ---- Optional ----
# TLS for remote databases: verify (default) | require (encrypt, skip certificate check) | disable
# Only set this if the app logs a certificate error when connecting.
DATABASE_SSL=
# Connections per server instance (defaults: 3 on Vercel, 10 elsewhere)
DB_POOL_MAX=

# Telegram alerts: bot token from @BotFather. Chat IDs are set in the app (More → Settings).
TELEGRAM_BOT_TOKEN=

# Register photo reading: Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Tests only (never point this at real data; tests wipe it) ----
TEST_DATABASE_URL=postgres://yarn:yarn@localhost:5432/yarncrm_test

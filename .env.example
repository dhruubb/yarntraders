# ---- Required ----
# PostgreSQL connection string
DATABASE_URL=postgres://yarn:yarn@localhost:5432/yarncrm

# Random long string used to sign nothing secret-critical but required for cron endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# ---- Telegram alerts (optional, recommended) ----
# Create a bot with @BotFather in Telegram and paste its token here.
# The chat ID(s) to send to are set inside the app: Settings → Notifications.
TELEGRAM_BOT_TOKEN=

# ---- Handwritten register OCR (optional) ----
# Anthropic API key from https://console.anthropic.com. Each register photo costs a few rupees.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Tests only ----
TEST_DATABASE_URL=postgres://yarn:yarn@localhost:5432/yarncrm_test
